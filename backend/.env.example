FUZE_ENV=development

# Start PostgreSQL with docker compose up -d database, then uncomment this URL.
# DATABASE_URL=postgresql://fuze:local-development-only@localhost:5432/fuze

# auto selects Groq, Gemini, or Z.ai when its key is present; otherwise basic planning.
# Explicit alternatives: disabled, groq, gemini, zai, ollama, custom.
FUZE_LLM_PROVIDER=auto

# Free hosted tiers still require your own key; never commit it.
# GROQ_API_KEY=
# GEMINI_API_KEY=
# ZAI_API_KEY=
# Generic key for the explicitly selected provider, or legacy Z.ai configuration:
# FUZE_LLM_API_KEY=

# Groq defaults to a model listed on the Free Plan (account quotas still apply).
# To select it explicitly, also set GROQ_API_KEY above:
# FUZE_LLM_PROVIDER=groq
# FUZE_LLM_MODEL=openai/gpt-oss-120b
# FUZE_LLM_BASE_URL=https://api.groq.com/openai/v1
# Native provider keys take precedence over FUZE_LLM_API_KEY.

# Gemini uses gemini-3.8-flash at Google's OpenAI-compatible endpoint by default.
# To select Gemini explicitly (also set GEMINI_API_KEY above):
# FUZE_LLM_PROVIDER=gemini
# Optional overrides; remove old values to use the provider defaults:
# FUZE_LLM_MODEL=gemini-3.8-flash
# FUZE_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Local inference without an account or key (requires Ollama and an installed model):
# FUZE_LLM_PROVIDER=ollama
# FUZE_LLM_MODEL=fuze-local
# FUZE_LLM_BASE_URL=http://localhost:11434/v1
FUZE_LLM_MAX_TOKENS=4096
# Limits per execution attempt; identical requests are reused within that attempt.
FUZE_LLM_MAX_CALLS=40
FUZE_LLM_TOKEN_BUDGET=120000

FUZE_ORIGINS=http://localhost:5173,http://localhost:5174
FUZE_COOKIE_SECURE=0
FUZE_COOKIE_SAMESITE=lax
FUZE_MAX_ACTIVE_RUNS=4
FUZE_RUN_TIMEOUT_SECONDS=600

# Optional evidence discovery. Never put this key in frontend/VITE variables.
# EXA_API_KEY=
FUZE_RESEARCH_ENABLED=1
FUZE_RESEARCH_MAX_CALLS=6
FUZE_RESEARCH_BUDGET_USD=0.12
FUZE_EVIDENCE_MAX_PARTS=3

# Replay distributor recordings. This is not current stock/price information and
# does not disable AI separately. Unrecorded requests fail instead of going online.
# FUZE_FIXTURES=1
