CONTINUITY_ENV=development

# Start PostgreSQL with docker compose up -d database, then uncomment this URL.
# DATABASE_URL=postgresql://continuity:local-development-only@localhost:5432/continuity

# auto selects Groq, Gemini, or Z.ai when its key is present; otherwise basic planning.
# Explicit alternatives: disabled, groq, gemini, zai, ollama, custom.
CONTINUITY_LLM_PROVIDER=auto

# Free hosted tiers still require your own key; never commit it.
# GROQ_API_KEY=
# GEMINI_API_KEY=
# ZAI_API_KEY=
# Generic key for the explicitly selected provider, or legacy Z.ai configuration:
# CONTINUITY_LLM_API_KEY=

# Local inference without an account or key (requires Ollama and an installed model):
# CONTINUITY_LLM_PROVIDER=ollama
# CONTINUITY_LLM_MODEL=continuity-local
# CONTINUITY_LLM_BASE_URL=http://localhost:11434/v1
CONTINUITY_LLM_MAX_TOKENS=4096

CONTINUITY_ORIGINS=http://localhost:5173,http://localhost:5174
CONTINUITY_COOKIE_SECURE=0
CONTINUITY_COOKIE_SAMESITE=lax
CONTINUITY_MAX_ACTIVE_RUNS=4
CONTINUITY_RUN_TIMEOUT_SECONDS=600

# Replay distributor recordings. This is not current stock/price information and
# does not disable AI separately. Unrecorded requests fail instead of going online.
# CONTINUITY_FIXTURES=1
